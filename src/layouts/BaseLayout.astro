---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { site, path } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  headerTone?: "brand" | "cream";
}
const {
  title,
  description = `${site.business.name_he} — ${site.business.tagline_he}. אופני הרים, חשמליים, ילדים ועיר, אביזרים וסדנת תיקונים ב${site.contact.address_he}.`,
  headerTone = "brand",
} = Astro.props;
const fullTitle = title ? `${title} | ${site.business.name_he}` : `${site.business.name_he} | ${site.business.tagline_he}`;
// Served from a sub-folder (GitHub Pages) = design preview, not the store's live site.
const preview = import.meta.env.BASE_URL !== "/";
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f77c14" />
    <link rel="icon" href={path("/favicon.svg")} type="image/svg+xml" />
    <!-- Motion gate: hide entrance states only when JS runs and motion is allowed.
         If the motion script has not started within 3s, show everything. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        // Palette: ?palette=cream|orange wins, then the visitor's last choice.
        try {
          var q = new URLSearchParams(location.search).get("palette");
          var p = q || localStorage.getItem("palette");
          if (q) localStorage.setItem("palette", q);
          if (p === "cream") d.dataset.palette = "cream";
        } catch (e) {}
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          d.classList.add("motion-ok");
          setTimeout(function () {
            if (!window.__motionReady) d.classList.remove("motion-ok");
          }, 3000);
        }
      })();
    </script>
  </head>
  <body>
    {preview && (
      <p class="preview-banner" role="note">
        תצוגה מקדימה של עיצוב האתר החדש · זה אינו האתר הרשמי של החנות
      </p>
    )}
    <a class="skip-link" href="#main">דלגו לתוכן</a>
    <Header tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/motion/index";
    </script>
  </body>
</html>
