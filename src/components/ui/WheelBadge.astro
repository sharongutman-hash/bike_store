---
/** Small spoked-wheel badge (the brand's stand-in for the reference's smiley). Springs in on scroll. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<span class:list={["wheel-badge", className]} data-pop aria-hidden="true">
  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
    <circle cx="24" cy="24" r="20" />
    <circle cx="24" cy="24" r="14" stroke-width="1.4" />
    <circle cx="24" cy="24" r="3" />
    <path d="M24 10v11M24 27v11M10 24h11M27 24h11M14 14l7.9 7.9M26.1 26.1 34 34M34 14l-7.9 7.9M21.9 26.1 14 34" stroke-width="1.2" />
  </svg>
</span>

<style>
  .wheel-badge {
    display: inline-grid;
    place-items: center;
    width: 3em;
    height: 3em;
    padding: 0.35em;
    border-radius: var(--radius-round);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-card);
  }
  .wheel-badge svg { width: 100%; height: 100%; }
  @media (prefers-reduced-motion: no-preference) {
    .wheel-badge svg { animation: wheel-spin 9s linear infinite; }
  }
  @keyframes wheel-spin { to { rotate: 1turn; } }
</style>
