---
/** Inline icon set (stroke icons on a 24px grid). Decorative unless a label is given. */
export type IconName =
  | "arrow" | "arrow-right" | "arrow-left" | "whatsapp" | "facebook" | "phone" | "mail"
  | "pin" | "clock" | "check" | "close" | "star" | "menu" | "bag" | "wrench" | "wheel" | "filter";

interface Props {
  name: IconName;
  label?: string;
  class?: string;
}
const { name, label, class: className } = Astro.props;
---
<svg
  class:list={["icon", className, { "icon--mirror": name === "arrow" }]}
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
>
  {name === "arrow" && <path d="M17 7 7 17M9 7h8v8" />}
  {name === "arrow-right" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "arrow-left" && <path d="M19 12H5M11 6l-6 6 6 6" />}
  {name === "whatsapp" && (
    <>
      <path d="M3.5 20.5 5 16.3A8.5 8.5 0 1 1 8 19.2Z" />
      <path d="M9 8.8c.2 2.8 3 5.8 6 6.2l1.3-1.3-2-1.2-.9.8a5 5 0 0 1-2.6-2.6l.8-.9-1.2-2Z" stroke-width="1.4" />
    </>
  )}
  {name === "facebook" && <path d="M14 8.5h2.5V5H14a3.5 3.5 0 0 0-3.5 3.5V11H8v3.5h2.5V21H14v-6.5h2.5L17 11h-3V9a.5.5 0 0 1 .5-.5Z" />}
  {name === "phone" && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" />}
  {name === "mail" && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>)}
  {name === "pin" && (<><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>)}
  {name === "clock" && (<><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>)}
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "star" && <path d="m12 3 2.8 5.8 6.2.9-4.5 4.4 1 6.2L12 17.4l-5.5 2.9 1-6.2L3 9.7l6.2-.9Z" fill="currentColor" stroke="none" />}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "filter" && <path d="M4 6h16M7 12h10M10 18h4" />}
  {name === "bag" && (<><path d="M5 8h14l-1 12H6Z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></>)}
  {name === "wrench" && <path d="M14.5 6.5a4 4 0 0 0 5 5L13 18a2.1 2.1 0 0 1-3-3l6.5-6.5a4 4 0 0 0-5-5l2.5 2.5-.5 2.5-2.5.5Z" />}
  {name === "wheel" && (<><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="2" /><path d="M12 3v7M12 14v7M3 12h7M14 12h7M5.6 5.6l5 5M13.4 13.4l5 5M18.4 5.6l-5 5M10.6 13.4l-5 5" stroke-width="1.2" /></>)}
</svg>
<style>
  .icon { flex: none; }
  /* The diagonal "go" arrow points toward the reading direction */
  :global([dir="rtl"]) .icon--mirror { transform: scaleX(-1); }
</style>
