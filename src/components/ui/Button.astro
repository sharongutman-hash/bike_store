---
/**
 * Pill button with the icon inside: the arrow after the label, other icons before it.
 * icon={false} leaves the label only.
 * Hover: the pill lifts and the icon nudges forward.
 */
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  href?: string;
  type?: "button" | "submit";
  tone?: "ink" | "light" | "brand";
  size?: "m" | "l";
  icon?: IconName | false;
  external?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
  "aria-label"?: string;
}
const {
  href,
  type = "button",
  tone = "ink",
  size = "m",
  icon = "arrow",
  external = false,
  class: className,
  ...rest
} = Astro.props;
const Tag = href ? "a" : "button";
// The arrow means "go to another page": it follows the text (on the left in Hebrew).
// Other icons (phone, WhatsApp, map pin…) come before the text.
const trailing = icon === "arrow";
const linkProps = href
  ? { href, ...(external ? { target: "_blank", rel: "noopener" } : {}) }
  : { type };
---
<Tag class:list={["btn", `btn--${tone}`, `btn--${size}`, className]} {...linkProps} {...rest}>
  <span class="btn__label">
    {icon && !trailing && <span class="btn__icon" aria-hidden="true"><Icon name={icon} /></span>}
    <slot />
    {trailing && <span class="btn__icon" aria-hidden="true"><Icon name="arrow" /></span>}
  </span>
</Tag>

<style>
  .btn {
    --btn-bg: var(--color-ink);
    --btn-fg: var(--color-surface);
    display: inline-flex;
    align-items: center;
    gap: 0.125em;
    min-height: var(--tap-min);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: 1.125em;
    line-height: 1;
    color: var(--btn-fg);
    cursor: pointer;
    isolation: isolate;
    -webkit-user-select: none;
    user-select: none;
  }
  .btn--light { --btn-bg: var(--color-surface); --btn-fg: var(--color-ink); }
  .btn--brand { --btn-bg: var(--color-brand); --btn-fg: var(--color-ink); }
  .btn--l { font-size: 1.375em; }

  .btn__label {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: 2.5em;
    padding: 0.35em 1.1em 0.45em;
    border-radius: var(--radius-pill);
    background-color: var(--btn-bg);
    white-space: nowrap;
    transition:
      translate var(--duration-base) var(--ease-default),
      scale var(--duration-base) var(--ease-default),
      box-shadow var(--duration-base) var(--ease-smooth);
  }
  .btn__icon {
    display: inline-grid;
    place-items: center;
    font-size: 0.9em;
    transition: translate var(--duration-elastic) var(--ease-elastic);
  }

  @media (hover: hover) {
    .btn:hover .btn__label { translate: 0 -0.12em; box-shadow: var(--shadow-card); }
    .btn:hover .btn__icon { translate: 0.15em 0; }
    :global([dir="rtl"]) .btn:hover .btn__icon { translate: -0.15em 0; }
  }
  .btn:active .btn__label {
    scale: 0.96;
    transition-duration: var(--duration-instant);
  }
  .btn:focus-visible { outline: none; }
  .btn:focus-visible .btn__label {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  :global(.on-dark) .btn:focus-visible .btn__label {
    outline-color: var(--color-focus-on-dark);
  }
</style>
