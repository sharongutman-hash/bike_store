---
/**
 * Product page. One static page per product in content/products.json.
 * Ordering goes through WhatsApp / phone for now (the current site has no working checkout).
 */
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import Price from "../../components/ui/Price.astro";
import StatBubble from "../../components/ui/StatBubble.astro";
import Scribble from "../../components/ui/Scribble.astro";
import WaveMarquee from "../../components/home/WaveMarquee.astro";
import ProductCard from "../../components/shop/ProductCard.astro";
import {
  products, slugify, displayName, typePrefix, contentImage, cutout, currentPrice,
  specLabels, whatsappHref, telHref, site, flatCategories, productHref, teaser, type Product,
} from "../../lib/content";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: slugify(product) }, props: { product } }));
}

interface Props { product: Product }
const { product } = Astro.props;
const name = displayName(product);
const prefix = typePrefix(product);
const cut = cutout(product);
const flat = flatCategories();
const leaf = flat.find((c) => c.id === product.representing_category.id)!;
const crumbs = [
  { label: "דף הבית", href: "/" },
  { label: "החנות", href: "/shop/" },
  ...(leaf.parent && leaf.parent.id !== 21 ? [{ label: leaf.parent.name_he, href: `/shop/?cat=${leaf.parent.id}` }] : []),
  { label: leaf.name_he, href: `/shop/?cat=${leaf.id}` },
];

// Up to three short spec values become bubbles; everything goes in the table.
const bubbleKeys = ["wheel_size", "battery", "weight", "frame_size", "age", "drivetrain"];
const bubbles = bubbleKeys
  .filter((k) => product.specs[k] && product.specs[k].length <= 18)
  .slice(0, 3)
  .map((k) => ({ label: specLabels[k], value: product.specs[k] }));
const specRows = Object.entries(product.specs).map(([k, v]) => ({ label: specLabels[k] ?? k, value: v }));
// The scraped description is broken mid-sentence; rejoin lines into sentences/paragraphs.
const paragraphs = product.description_he
  .split("\n")
  .map((l) => l.trim())
  .filter((l) => l && !/^[^:]{2,20}:\s/.test(l) && !/^מפרט/.test(l) && l !== ":")
  .reduce<string[]>((acc, line) => {
    const last = acc[acc.length - 1];
    if (last !== undefined && !/[.!?…]$/.test(last)) acc[acc.length - 1] = `${last} ${line}`.replace(/\s+([.,!?])/g, "$1");
    else acc.push(line);
    return acc;
  }, []);

const pageUrl = new URL(productHref(product), Astro.site).href;
const orderText = `היי סלאלום, אני מתעניין/ת ב-${name} (${pageUrl})`;
const related = products
  .filter((p) => p.id !== product.id)
  .sort((a, b) => Number(b.categories_he.some((c) => product.categories_he.includes(c) && c !== "אופניים")) - Number(a.categories_he.some((c) => product.categories_he.includes(c) && c !== "אופניים")))
  .slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  brand: product.brand ? { "@type": "Brand", name: product.brand } : undefined,
  image: product.images.map((i) => i.src),
  description: teaser(product, 300),
  offers: {
    "@type": "Offer",
    priceCurrency: "ILS",
    price: currentPrice(product),
    availability: product.in_stock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    url: pageUrl,
  },
};
---
<BaseLayout title={name} description={teaser(product, 155) || `${name} בסלאלום פרדס חנה`} headerTone="cream">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="pdp container" aria-labelledby="pdp-title">
    <nav class="crumbs small" aria-label="פירורי לחם">
      <ol role="list">
        {crumbs.map((c) => (<li><a href={c.href}>{c.label}</a></li>))}
        <li aria-current="page">{name}</li>
      </ol>
    </nav>

    <div class="pdp__grid">
      <div class="gallery" data-gallery>
        <div class:list={["gallery__stage", { "gallery__stage--cutout": cut }]} data-tilt>
          {cut && (
            <div class="gallery__slide" data-gallery-slide data-tilt-target>
              <Image src={cut} alt={name} widths={[480, 720, 960, 1200]} sizes="(max-width: 991px) 92vw, 52vw" loading="eager" fetchpriority="high" format="webp" />
            </div>
          )}
          {product.images.map((img, i) => (
            <div class="gallery__slide gallery__slide--photo" data-gallery-slide hidden={Boolean(cut) || i > 0}>
              <Image src={contentImage(img.local)} alt={`${name} — תמונה ${i + 1}`} widths={[480, 720, 960, 1200]} sizes="(max-width: 991px) 92vw, 52vw" loading={!cut && i === 0 ? "eager" : "lazy"} format="webp" />
            </div>
          ))}
        </div>
        {(product.images.length > 1 || cut) && (
          <ul role="list" class="gallery__thumbs" aria-label="תמונות המוצר">
            {cut && (
              <li><button type="button" class="gallery__thumb" data-gallery-thumb aria-current="true" aria-label="תמונה ראשית">
                <Image src={cut} alt="" widths={[160]} sizes="5em" format="webp" />
              </button></li>
            )}
            {product.images.map((img, i) => (
              <li><button type="button" class="gallery__thumb" data-gallery-thumb aria-current={!cut && i === 0 ? "true" : "false"} aria-label={`תמונה ${i + 1}`}>
                <Image src={contentImage(img.local)} alt="" widths={[160]} sizes="5em" format="webp" />
              </button></li>
            ))}
          </ul>
        )}
      </div>

      <div class="buy">
        <p class="buy__cat small">{prefix ?? leaf.name_he}{product.brand && <span class="buy__brand">{product.brand}</span>}</p>
        <h1 id="pdp-title" class="buy__name display">{name}</h1>
        <Price product={product} size="l" />
        <p class="buy__stock small">
          <span class="buy__dot" aria-hidden="true" />{product.in_stock ? "במלאי בחנות" : "לא במלאי כרגע"}
        </p>
        {teaser(product) && <p class="buy__teaser">{teaser(product, 220)}</p>}

        {bubbles.length > 0 && (
          <ul role="list" class="buy__bubbles" data-reveal-children="pop">
            {bubbles.map((b) => (<li><StatBubble value={b.value} label={b.label} class="buy__bubble" /></li>))}
          </ul>
        )}

        <div class="buy__actions">
          <Button href={whatsappHref(orderText)} icon="whatsapp" size="l" external>להזמנה בווטסאפ</Button>
          <Button href={telHref(site.contact.mobile)} icon="phone" tone="light">{site.contact.mobile}</Button>
        </div>
        <ul role="list" class="buy__perks small">
          <li><Icon name="wrench" /> סדנת תיקונים מקצועית בחנות</li>
          <li><Icon name="pin" /> {site.contact.address_he}</li>
          <li><Icon name="clock" /> א׳–ה׳ 10:00–17:00 (ג׳ עד 13:00) · ו׳ 09:00–13:00</li>
        </ul>
        <Scribble text={"בואו לנסות\nבחנות"} arrow="down-end" class="buy__note" />
      </div>
    </div>
  </section>

  <WaveMarquee text={`${name} · ${product.brand ?? ""} · סלאלום · `} tone="brand" id="pdp-wave" />

  <section class="details container" aria-label="פרטי המוצר">
    {specRows.length > 0 && (
      <div class="details__specs">
        <h2 class="display display-s" data-highlight-text>מפרט טכני</h2>
        <table class="specs" data-lines>
          <caption class="sr-only">מפרט טכני של {name}</caption>
          <tbody>
            {specRows.map((r) => (
              <tr>
                <th scope="row">{r.label}<span class="specs__rule" data-line aria-hidden="true" /></th>
                <td><bdi>{r.value}</bdi></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    {paragraphs.length > 0 && (
      <div class="details__desc">
        <h2 class="display display-s" data-highlight-text>על המוצר</h2>
        <div class="details__text" data-reveal>
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    )}
  </section>

  <section class="related container" aria-labelledby="related-title">
    <h2 id="related-title" class="display display-m" data-highlight-text>אולי יעניין <span class="text-accent">אתכם</span></h2>
    <ul role="list" class="related__grid" data-reveal-children>
      {related.map((p, i) => <ProductCard product={p} index={i} />)}
    </ul>
  </section>
</BaseLayout>

<style>
  .pdp { padding-top: 6.5em; padding-bottom: 10em; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.25em 0.5em; padding: 0; color: var(--color-ink-soft); }
  .crumbs li:not(:last-child)::after { content: "/"; margin-inline-start: 0.5em; opacity: 0.5; }
  .crumbs a { display: inline-flex; min-height: var(--tap-min); align-items: center; text-decoration: underline; text-decoration-color: transparent; }
  .crumbs a:hover { text-decoration-color: currentColor; }
  .crumbs [aria-current] { display: inline-flex; align-items: center; color: var(--color-ink); font-weight: var(--weight-medium); }

  .pdp__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 3em;
    align-items: start;
    margin-top: 1em;
  }

  .gallery { position: sticky; top: 1.5em; display: grid; gap: 0.75em; }
  .gallery__stage {
    display: grid;
    border-radius: var(--radius-l);
    background: var(--color-surface);
    padding: 0.75em;
    overflow: hidden;
  }
  .gallery__stage--cutout { background: var(--color-brand); padding: 3em 2em; }
  .gallery__slide { grid-area: 1 / 1; display: grid; place-items: center; }
  .gallery__slide img { width: 100%; height: auto; }
  .gallery__stage--cutout .gallery__slide:not(.gallery__slide--photo) img {
    filter: drop-shadow(0 1.5em 1.5em rgb(26 20 16 / 0.25));
    max-height: 32em;
    width: auto;
  }
  .gallery__stage--cutout .gallery__slide--photo { margin: -2em -1.25em; }
  .gallery__slide--photo img { border-radius: var(--radius-m); aspect-ratio: 4 / 3; object-fit: cover; }
  .gallery__thumbs { display: flex; flex-wrap: wrap; gap: 0.5em; padding: 0; }
  .gallery__thumb {
    width: 5em;
    height: 5em;
    padding: 0.25em;
    border-radius: var(--radius-m);
    background: var(--color-surface);
    border: 2px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-smooth), scale var(--duration-elastic) var(--ease-elastic);
  }
  .gallery__thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-s); }
  .gallery__thumb[aria-current="true"] { border-color: var(--color-ink); }
  @media (hover: hover) { .gallery__thumb:hover { scale: 1.06; } }

  .buy { position: relative; display: grid; gap: 1em; justify-items: start; }
  .buy__cat { display: flex; flex-wrap: wrap; gap: 0.5em; align-items: center; font-weight: var(--weight-medium); color: var(--color-ink-soft); }
  .buy__brand { padding: 0.1em 0.75em 0.2em; border-radius: var(--radius-pill); background: var(--color-ink); color: var(--color-surface); direction: ltr; }
  .buy__name { font-size: 5.25em; font-weight: var(--weight-bold); direction: ltr; text-align: end; justify-self: stretch; }
  .buy__stock { display: inline-flex; align-items: center; gap: 0.5em; font-weight: var(--weight-medium); }
  .buy__dot { width: 0.6em; height: 0.6em; border-radius: var(--radius-round); background: var(--color-success); }
  .buy__teaser { max-width: 46ch; }
  .buy__bubbles { display: flex; flex-wrap: wrap; gap: 0.5em; padding: 0; }
  .buy__bubbles :global(.stat) { width: 8.5em; background: var(--color-surface); }
  .buy__bubbles :global(.stat__number) { font-size: 2em; line-height: 0.9; direction: ltr; }
  .buy__actions { display: flex; flex-wrap: wrap; gap: 0.75em; margin-top: 0.5em; }
  .buy__perks { display: grid; gap: 0.5em; padding: 0; margin-top: 0.5em; }
  .buy__perks li { display: flex; align-items: center; gap: 0.5em; }
  .buy__note { position: absolute; inset-inline-end: 0; bottom: -6em; }

  .details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3em;
    padding-block: 14em 4em;
  }
  .specs { width: 100%; margin-top: 1em; border-collapse: collapse; }
  .specs th, .specs td { padding: 0.8em 0; text-align: start; vertical-align: top; }
  .specs th { position: relative; width: 38%; font-weight: var(--weight-bold); padding-inline-end: 1em; }
  .specs td { border-bottom: 1px solid var(--color-line); }
  .specs__rule { position: absolute; inset-inline: 0; bottom: 0; height: 1px; background: var(--color-line); }
  .details__text { display: grid; gap: 0.75em; margin-top: 1em; font-size: var(--text-body); max-width: 60ch; }

  .related { padding-block: 4em 6em; }
  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gutter);
    padding: 0;
    margin-top: 1.5em;
  }

  @media screen and (max-width: 991px) {
    .pdp__grid, .details { grid-template-columns: 1fr; }
    .gallery { position: static; }
    .related__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 479px) {
    .pdp { padding-top: 5.5em; padding-bottom: 8em; }
    .buy__note { display: none; }
    .details { padding-top: 10em; }
    .related__grid { grid-template-columns: 1fr; }
  }
</style>
